# The CesiumMan preview bundle is a redistributable, hash-pinned runtime
# fixture.  Keep its source texture with the OBJ and manifest; all generated
# humanoid textures remain ignored below.
!stretch_mujoco/models/assets/humanoid/cesium_man.png

# Local task tracking files; do not include them in feature PRs.
/aaa_workspace/task/

# Local raw asset staging is shared from the primary worktree, never committed.
/aaa_workspace/raw_resources/**
!/aaa_workspace/raw_resources/README.md

# Shared experimental payloads stay local; document their layout outside them.
/aaa_workspace/experiments/**

# Retired local backups and superseded outputs are preserved here, never committed.
/aaa_workspace/archive/

# Local visual demos, acceptance runs, and generated diagnostics.
/aaa_workspace/demo1/
/aaa_workspace/demo_new/
/aaa_workspace/interaction_acceptance_candidate/
