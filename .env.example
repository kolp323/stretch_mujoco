# Optional runtime locations. The application reads these variables directly;
# copy the values into your shell environment rather than committing `.env`.
STRETCH_MUJOCO_OUTPUT_DIR=outputs
STRETCH_MUJOCO_CACHE_DIR=/tmp/stretch_mujoco

# External datasets/checkouts are required only by the corresponding tools.
# STRETCH_MUJOCO_HSSD_ROOT=/path/to/hssd-hab
# STRETCH_MUJOCO_ROBOTWIN_ROOT=/path/to/RoboTwin/assets/objects
# STRETCH_MUJOCO_OPENPI_ROOT=/path/to/openpi
# STRETCH_MUJOCO_GRASPGEN_HOST=127.0.0.1
