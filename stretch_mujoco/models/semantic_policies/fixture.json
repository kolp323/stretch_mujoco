    {"id": "tables", "match": {"category": "table"}, "semantic_class": "furniture.counter", "affordances": ["approach"], "navigation_requirement": "approach", "point_bundle": "perimeter_approach"},
    {"id": "graspables", "match": {"category": "interactive"}, "semantic_class": "object.graspable", "affordances": ["approach", "grasp"], "navigation_requirement": "approach", "point_bundle": "graspable_on_support"}
  ],
