             file="humanoid/generated/animations/smplx_npc_01_diffuse.png"/>
    <texture name="npc_02_texture" type="2d"
             file="humanoid/generated/animations/smplx_npc_02_diffuse.png"/>
    <texture name="npc_03_texture" type="2d"
             file="humanoid/generated/animations/smplx_npc_03_diffuse.png"/>

