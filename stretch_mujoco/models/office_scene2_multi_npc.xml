       Scene wrapper that includes the generated Scene 2 and adds
       properly-named semantic bodies, humanoid NPCs with distinct
       appearances, and interaction sites for the multi-NPC simulation.
       ============================================================ -->

  <!-- Robot-only model; this wrapper supplies the multi-NPC office layout below. -->
  <include file="assets/office_scenes/office_02_cross_axis_robot.xml"/>

  <!-- SMPL-X humanoid mesh assets (animation frame OBs) -->
